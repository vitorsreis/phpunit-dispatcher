#!/usr/bin/env php
<?php

if (!!ini_get('phar.readonly')) {
    fwrite(STDERR, "phar.readonly must be disabled to build the PHAR.\n");
    exit(1);
}

$root = dirname(__DIR__);
$buildDirectory = $root . DIRECTORY_SEPARATOR . 'build' . DIRECTORY_SEPARATOR . 'phar';
$pharPath = $buildDirectory . DIRECTORY_SEPARATOR . 'phpunit-dispatcher.phar';
$checksumPath = $pharPath . '.sha256';
$alias = 'phpunit-dispatcher.phar';

if (!is_dir($buildDirectory) && !mkdir($buildDirectory, 0755, true) && !is_dir($buildDirectory)) {
    fwrite(STDERR, "Unable to create build directory.\n");
    exit(1);
}

@unlink($pharPath);
@unlink($checksumPath);
$phar = new Phar($pharPath, 0, $alias);
$phar->startBuffering();
foreach (packageFiles($root) as $local => $source) {
    $phar->addFile($source, $local);
}
$phar->setStub("#!/usr/bin/env php\n<?php\nPhar::mapPhar('$alias');\nrequire 'phar://$alias/bin/phpunit-dispatcher';\n__HALT_COMPILER();");
$phar->setSignatureAlgorithm(Phar::SHA256);
$phar->stopBuffering();
@chmod($pharPath, 0755);

$checksum = hash_file('sha256', $pharPath);
if ($checksum === false) {
    fwrite(STDERR, "Unable to calculate PHAR checksum.\n");
    exit(1);
}
file_put_contents($checksumPath, $checksum . '  phpunit-dispatcher.phar' . PHP_EOL);
fwrite(STDOUT, $pharPath . PHP_EOL);

function packageFiles($root)
{
    $files = array();
    foreach (array('composer.json', 'README.md', 'LICENSE') as $relative) {
        $path = $root . DIRECTORY_SEPARATOR . $relative;
        if (is_file($path)) {
            $files[$relative] = $path;
        }
    }
    foreach (array('src') as $directory) {
        $path = $root . DIRECTORY_SEPARATOR . $directory;
        if (!is_dir($path)) {
            continue;
        }
        $iterator = new RecursiveIteratorIterator(
                new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS)
        );
        foreach ($iterator as $file) {
            if (!$file instanceof SplFileInfo || !$file->isFile()) {
                continue;
            }
            $local = str_replace('\\', '/', substr($file->getPathname(), strlen($root) + 1));
            $files[$local] = $file->getPathname();
        }
    }

    $entrypoint = $root . DIRECTORY_SEPARATOR . 'bin' . DIRECTORY_SEPARATOR . 'phpunit-dispatcher';
    if (is_file($entrypoint)) {
        $files['bin/phpunit-dispatcher'] = $entrypoint;
    }
    return $files;
}
