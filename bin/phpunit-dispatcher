#!/usr/bin/env php
<?php

spl_autoload_register(function ($class) {
    $prefix = 'PUD\\';
    if (strpos($class, $prefix) !== 0) {
        return;
    }

    $relative = substr($class, strlen($prefix));
    $file = dirname(__DIR__) . '/src/' . str_replace('\\', '/', $relative) . '.php';
    if (is_file($file)) {
        require $file;
    }
});

exit(PUD\Application::run(isset($argv) ? $argv : array()));
